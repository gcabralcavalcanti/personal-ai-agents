# Copy to .env (never committed). The code reads configuration from the environment or from this file.
# Writes to Todoist go through Claude Code's Todoist connector (authorized with OAuth), never through this code.

# Where the gate hook keeps its 15-minute approval flags (default: <repo>/.flags, git-ignored).
GATE_FLAGS_DIR=

# Claude API key for the job triage and the live evals. Without it they replay recorded answers (demo mode).
ANTHROPIC_API_KEY=
# Optional overrides (defaults in src/llm/config.py)
# AGENTS_MODEL=claude-haiku-5-5
# AGENTS_MAX_CALLS=30

# Optional: your Todoist token, only for the read-only todoist_export.py (Settings > Integrations > Developer).
TODOIST_API_TOKEN=
